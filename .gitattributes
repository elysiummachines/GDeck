# Normalise line endings in the repository, check out whatever is native.
* text=auto

# Binary assets, which must never be line ending converted. The fonts in
# particular would be silently corrupted by it.
*.ttf binary
*.otf binary
*.png binary
*.ico binary
*.res binary

# README assets. A GIF or a JPEG is full of bytes that look like line
# endings, and text=auto only guesses binary from a NUL in the first 8000
# bytes. Guessing is not good enough for a demo that would be silently
# corrupted on the way in.
*.gif binary
*.jpg binary
*.jpeg binary
*.webp binary

# Keep these as they are written.
*.ps1 text
*.rs  text
*.md  text
*.toml text
